---
import Navigation from '../components/Navigation.astro';
import werkplaats1 from '../assets/werkplaats1.png';
import werkplaats2 from '../assets/werkplaats2.png';
import werkplaats3 from '../assets/werkplaats3.png';
import werkplaats4 from '../assets/werkplaats4.png';
import yeloli from '../assets/yeloli.png';

const projects = [
  {
    title: "AD Software Development Jaar 1 Periode 1 Project",
    image: werkplaats1,
    description: "Dit is een runner game gemaakt met Python en Pygame. De speler bestuurt een personage met pijljestoetsen. De player moet over de enemy springen om zo lang mogelijk te overleven. Je score stijgt als je over de enemy heeft gesprongen. Als de player tegen de enemy bots, dan is het game over. En als extra feature kan de achtergrond van de game worden veranderd",
    date: "06-11-2025",
  },

  {
    title: "AD Software Development Jaar 1 Periode 2 Project",
    image: werkplaats2,
    description: "In dit webapplicatie kan: Ervaringsdeskundige profiel aanmaken, passende onderzoeken zoeken en inschrijven voor onderzoeken. Beheerder nieuwe registraties, onderzoeken en inschrijvingen goed- of afkeuren en  nieuwe accounts aan voor organisaties maken en Organisatie nieuwe onderzoeken indienen en zien hoeveel ervaringsdeskundigen zich hebben ingeschreven voor haar onderzoeken",
    date: "26-03-2026",
  },
  {
        title: "AD Software Development Jaar 1 Periode 3 Project",
        image: werkplaats3,
        description: "De leerling van de applicatie en kan alleen zijn/haar eigen voortgang en resultaten bekijken, inzicht krijgen in sterke en zwakke punten per leerdoel en per kernwoord/onderwerp en aanbevolen leerbronnen zien die aansluiten bij persoonlijke zwaktes. De docent is de primaire eindgebruiker en gebruikt de applicatie om de voortgang van individuele leerlingen te bekijken, de voortgang en zwakke/sterke punten van een gehele klas te analyseren en op basis daarvan gerichte vervolgstappen te plannen.",
        date: "11-06-2026",
    },
    {
        title: "AD Software Development Jaar 1 Periode 4 Project",
        image: werkplaats4,
        description: "Dit is PWA waarin studenten kunnen kiezen uit afstudeerprojecten bij bedrijven. Studenten moeten deze volgende dingen kunnen doen: de applicatie op hun homescreen van hun telefoon zetten, projecten bekijken, projecten delen met anderen (via een link), op projecten reageren (email-applicatie openen met nieuw emailvenster met vooringevuld email-adres), projecten opslaan om er later (offline) naar te kijken en de applicatie offline gebruiken.",
        date: "22-06-2026",
    },
    {
        title: "Yeloli Game",
        image: yeloli,
        description: "De regels van deze game zijn gebaseerd op een oude Digimon-game. De achtergrond en personages zijn gebaseerd op de animatieserie Yeluoli. Dit is een game voor twee spelers. Eerst kiezen beide spelers het personage dat ze willen spelen. Daarna kiezen ze het gevechtsgebied. Tijdens het gevecht is het doel om de healthbar van de tegenstander volledig leeg te maken. Zodra de healthbar van een speler leeg is, wint de andere speler. Besturing: Speler 1: WASD-toetsen voor beweging en F/G-toetsen voor skills. Speler 2: Pijltjestoetsen voor beweging en J/K-toetsen voor skills.",
        date: "31-12-2025",
    },
];
---

<section class="info">
		<h2>My Portfolio</h2>
		<Navigation />
		<div class="projects">
  {projects.map((project) => (
    <article class="project">

      <img src={project.image.src}  />

      <h3>{project.title}</h3>

      <p>{project.description}</p>

      <time>{project.date}</time>

    </article>
  ))}
</div>

       </section >

       <style>
       .projects {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 50px;

       }

       .project img {
          width: 100%;
          aspect-ratio: 20 / 10;
        }
       </style>